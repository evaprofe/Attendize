# =============================================================================
# Ejemplo de configuración de PRODUCCIÓN (Tarea 5) · SIN SECRETOS
# El archivo real .env.production NO se sube a GitHub: lo genera generar-env.sh
# leyendo Parameter Store en la propia instancia EC2.
# =============================================================================
APP_NAME=Moderniza
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_URL=https://DOMINIO_DE_LA_INSTANCIA
APP_KEY=OBTENIDA_DE_PARAMETER_STORE

DB_CONNECTION=mysql
DB_HOST=ENDPOINT_PRIVADO_DE_RDS
DB_PORT=3306
DB_DATABASE=attendize
DB_USERNAME=moderniza_app
DB_PASSWORD=OBTENIDA_DE_PARAMETER_STORE
DB_MIGRATIONS_TABLE=moderniza_migrations

# Registros por la salida estándar: se consultan con "docker compose logs"
LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
