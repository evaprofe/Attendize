# Proxy HTTPS de Moderniza (Tarea 5).
# Caddy redirige http -> https y añade X-Forwarded-Proto para Laravel.
{$SITE_DOMAIN} {
	{$CADDY_TLS}
	encode gzip
	reverse_proxy moderniza:80
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
